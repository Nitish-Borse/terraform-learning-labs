resource "aws_security_group" "my_sg" {
  name   = "terraform-learning-sg"
  vpc_id = var.vpc_id

  # For a real environment, restrict SSH to YOUR_PUBLIC_IP/32.
  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
